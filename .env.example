# Boop Admin: variáveis de ambiente. Copie para .env.local e preencha.
#
# As duas são CONFIG (públicas por natureza): a segurança dos dados vem das
# políticas de RLS do banco. O app não usa nenhuma chave secreta nem service role.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
