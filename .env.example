# Boop Admin: variáveis de ambiente. Copie para .env.local e preencha.
#
# As do Supabase são CONFIG (públicas por natureza): a segurança dos dados vem
# das políticas de RLS do banco. O app não usa nenhuma chave secreta do Supabase
# nem service role. As do push (no fim) são só para assinar as notificações.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Notificações no celular (Web Push). Gere o par com `npx web-push generate-vapid-keys`.
# A pública vai para o navegador; a privada e o segredo ficam só no servidor
# (Vercel → Settings → Environment Variables), nunca no código.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# O mesmo valor do segredo `push_webhook_secret` no Vault do Supabase: só o banco chama /api/push.
PUSH_WEBHOOK_SECRET=

# Instagram dos clientes (app da Meta: Instagram → API com login do Instagram).
# O ID e a chave secreta ficam só no servidor (Vercel), nunca no código. Sem
# eles, o cartão "Instagram" mostra "Integração com o Instagram não configurada".
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# O mesmo valor do segredo `instagram_jobs_secret` no Vault: só o banco chama /api/instagram/jobs.
INSTAGRAM_JOBS_SECRET=
